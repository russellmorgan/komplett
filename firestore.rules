rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Any signed-in user may read user docs (the Partner page lists everyone); only the owner writes.
    // ponytail: Firestore can't hide fields on read, so settings/partnerId are visible to friends too.
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if isOwner(uid);
    }

    // Readable by the owner and by their partner, only while both have picked each other — so
    // changing partner revokes the previous partner's access at once.
    match /sharedTasks/{uid} {
      function userDoc(id) { return get(/databases/$(database)/documents/users/$(id)).data; }
      function mutualPartner() {
        return signedIn()
          && userDoc(request.auth.uid).partnerId == uid
          && userDoc(uid).partnerId == request.auth.uid;
      }
      // A partner may only change `reactions` on a completed task, and only to hold their own
      // reaction. ponytail: rules can't diff arrays, so this allows at most one reaction — fine
      // with one partner; loosen to per-user checks when Phase 2 adds more partners.
      function onlyOwnReaction() {
        let next = request.resource.data.reactions;
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["reactions"])
          && resource.data.completedAt != null
          && next.size() <= 1
          && (next.size() == 0
            || (next[0].keys().hasOnly(["emoji", "byUserId", "at"])
              && next[0].byUserId == request.auth.uid
              && next[0].emoji in ["👏", "🔥", "🎉", "💪", "❤️", "🙌", "⭐", "🚀"]
              && next[0].at is number));
      }
      allow read: if isOwner(uid) || mutualPartner();
      allow write: if isOwner(uid);
      allow update: if mutualPartner() && onlyOwnReaction();
    }

    match /tasks/{id} {
      function inAList() { return request.resource.data.listId is string; }
      allow read, delete: if isOwner(resource.data.ownerId);
      allow create: if isOwner(request.resource.data.ownerId) && inAList();
      allow update: if isOwner(resource.data.ownerId) && isOwner(request.resource.data.ownerId) && inAList();
    }

    match /lists/{id} {
      allow read: if isOwner(resource.data.ownerId);
      allow create: if isOwner(request.resource.data.ownerId);
      allow update: if isOwner(resource.data.ownerId) && isOwner(request.resource.data.ownerId);
      allow delete: if isOwner(resource.data.ownerId) && !resource.data.isInbox;
    }

    match /sessions/{id} {
      allow read, delete: if isOwner(resource.data.ownerId);
      allow create: if isOwner(request.resource.data.ownerId);
      allow update: if isOwner(resource.data.ownerId) && isOwner(request.resource.data.ownerId);
    }

    match /folders/{id} {
      allow read: if isOwner(resource.data.ownerId);
      allow create: if isOwner(request.resource.data.ownerId);
      allow update: if isOwner(resource.data.ownerId) && isOwner(request.resource.data.ownerId);
      allow delete: if isOwner(resource.data.ownerId);
    }
  }
}
